[master]
{{ controlplane.name }} ansible_host={{ controlplane.ip }}

[worker]
{% for node in workers %}
{{ node.name }} ansible_host={{ node.ip }}
{% endfor %}

[k8s:children]
master
worker

[juju_machine]
juju-controller ansible_host={{ juju_ip }}

[gitlab_machine]
gitlab ansible_host={{ gitlab_ip }}

[all:vars]
ansible_user={{ vm_user }}
ansible_python_interpreter=/usr/bin/python3
# ansible_ssh_private_key_file is intentionally omitted here.
# When running locally: pass --private-key ~/.ssh/pfa_bouri_terraform
# When running in Semaphore: the key is injected automatically from Key Store.
